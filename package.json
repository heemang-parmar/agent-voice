{
  "name": "agent-voice",
  "version": "0.1.0",
  "private": true,
  "description": "A voice action layer for tool-using AI agents: full-duplex voice, live transcripts, and an honest action/approval/result protocol.",
  "license": "Apache-2.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/dev.sh",
    "dev:web": "pnpm --filter @agent-voice/web dev",
    "dev:worker": "bash scripts/worker.sh dev",
    "build": "pnpm -r --filter './packages/*' build && pnpm --filter @agent-voice/web build",
    "check": "bash scripts/check.sh",
    "check:web": "pnpm -r --filter './packages/*' --filter @agent-voice/web check",
    "check:worker": "bash scripts/worker.sh check",
    "check:env": "node scripts/check-env.mjs",
    "check:secrets": "bash scripts/secret-scan.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --filter './packages/*' --filter @agent-voice/web lint",
    "typecheck": "pnpm -r --filter './packages/*' --filter @agent-voice/web typecheck",
    "test": "pnpm -r --filter './packages/*' --filter @agent-voice/web test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  }
}
