# Agent Voice — local configuration template.
# Copy to `.env` (ignored by git) and fill in the values. Names only are ever
# printed by the health, readiness and check-env tooling; values are not.

# ---------------------------------------------------------------------------
# LiveKit (used by the web token route AND the worker)
# ---------------------------------------------------------------------------
# WebSocket URL of your LiveKit server (self-hosted or cloud).
LIVEKIT_URL=
# API key/secret pair for the same LiveKit project. Server-side only.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Realtime voice provider (worker only)
# ---------------------------------------------------------------------------
# Supported: openai-realtime (default) or livekit-inference.
AGENT_VOICE_REALTIME_PROVIDER=openai-realtime
# Required only for openai-realtime. LiveKit Inference uses the LiveKit
# credentials above for its managed STT -> LLM -> TTS pipeline.
OPENAI_API_KEY=
# Optional. Leave blank for provider defaults. Allowed values:
# openai-realtime model: gpt-realtime, gpt-4o-realtime-preview, gpt-4o-mini-realtime-preview
# openai-realtime voice: alloy, ash, ballad, cedar, coral, echo, marin, sage, shimmer, verse
# livekit-inference model: openai/gpt-4o-mini
# livekit-inference voice: rigel
AGENT_VOICE_REALTIME_MODEL=
AGENT_VOICE_REALTIME_VOICE=

# ---------------------------------------------------------------------------
# Delegated agent (worker only) — any OpenAI-compatible chat/completions endpoint
# ---------------------------------------------------------------------------
# Adapter selection. Supported: openai-http. Use "none" to run voice-only.
AGENT_VOICE_ADAPTER=openai-http
# Base URL of the agent's OpenAI-compatible API, e.g. http://127.0.0.1:8642/v1
AGENT_VOICE_AGENT_ENDPOINT=
# Optional bearer key for that endpoint.
AGENT_VOICE_AGENT_API_KEY=
# Model id passed to the endpoint.
AGENT_VOICE_AGENT_MODEL=default
# Stable key so the delegated agent can keep memory across sessions. Any opaque string.
AGENT_VOICE_SESSION_KEY=agent-voice-local
# Per-delegation timeout in seconds (1–120).
AGENT_VOICE_AGENT_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Shared
# ---------------------------------------------------------------------------
# Fixed worker name used for explicit dispatch. Must match on web and worker.
AGENT_VOICE_AGENT_NAME=agent-voice
# Exact origins allowed to call the token route (comma-separated).
AGENT_VOICE_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Participant token lifetime in seconds (60–900).
AGENT_VOICE_TOKEN_TTL_SECONDS=600
